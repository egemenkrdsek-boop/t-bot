{
  "name": "t-bot-cli",
  "version": "2.0.1",
  "description": "Local AI coding agent with CLI, Windows desktop tools and Telegram gateway",
  "type": "module",
  "main": "dist/desktop/main.js",
  "bin": {
    "tbot": "./dist/index.js",
    "t-bot": "./dist/index.js",
    "t-bot-cli": "./dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/egemenkrdsek-boop/t-bot.git"
  },
  "homepage": "https://github.com/egemenkrdsek-boop/t-bot",
  "bugs": {
    "url": "https://github.com/egemenkrdsek-boop/t-bot/issues"
  },
  "files": [
    "dist",
    "scripts",
    "assets",
    "docs",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "THIRD_PARTY_DEPENDENCIES.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "copy:desktop": "node scripts/copy-desktop.mjs",
    "build": "tsc && npm run copy:desktop",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --config electron-builder.yml --win --x64 --publish never",
    "start": "node --expose-gc dist/index.js",
    "dev": "tsx --expose-gc src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "node scripts/prepare.mjs",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "playwright-core": "^1.64.1",
    "typescript": "^5.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "tsx": "^4.19.0"
  }
}
