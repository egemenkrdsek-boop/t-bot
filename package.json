{
  "name": "t-bot-cli",
  "version": "2.0.0",
  "description": "T Bot 2.0 — Tri-Core Local AI Coding Agent, Autonomous Desktop Agent & Zero-Backend Telegram Bot Gateway with 50%-75% Token Savings and Deterministic Anti-Hallucination",
  "type": "module",
  "bin": {
    "tbot": "./dist/index.js",
    "t-bot": "./dist/index.js",
    "t-bot-cli": "./dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/egemenkrdsek-boop/t-bot.git"
  },
  "homepage": "https://github.com/egemenkrdsek-boop/t-bot",
  "bugs": {
    "url": "https://github.com/egemenkrdsek-boop/t-bot/issues"
  },
  "files": [
    "dist",
    "scripts",
    "assets",
    "docs",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --expose-gc dist/index.js",
    "dev": "tsx --expose-gc src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "node -e \"try { require('node:child_process').execSync('npm run build', { stdio: 'ignore' }); } catch {}\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "playwright-core": "^1.64.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
