{
  "name": "t-bot-cli",
  "version": "2.0.0",
  "description": "T Bot 2.0 — Tri-Core Local AI Coding Agent, Autonomous Desktop Agent & Zero-Backend Telegram Bot Gateway with 50%-75% Token Savings and Deterministic Anti-Hallucination",
  "type": "module",
  "main": "dist/desktop/main.js",
  "bin": {
    "tbot": "./dist/index.js",
    "t-bot": "./dist/index.js",
    "t-bot-cli": "./dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/egemenkrdsek-boop/t-bot.git"
  },
  "homepage": "https://github.com/egemenkrdsek-boop/t-bot",
  "bugs": {
    "url": "https://github.com/egemenkrdsek-boop/t-bot/issues"
  },
  "files": [
    "dist",
    "scripts",
    "assets",
    "docs",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "copy:desktop": "node -e \"const fs=require('fs'); fs.mkdirSync('dist/desktop/renderer',{recursive:true}); if(fs.existsSync('src/desktop/preload.cjs')) fs.copyFileSync('src/desktop/preload.cjs','dist/desktop/preload.cjs'); if(fs.existsSync('src/desktop/renderer')) fs.cpSync('src/desktop/renderer','dist/desktop/renderer',{recursive:true});\"",
    "build": "tsc && npm run copy:desktop",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --x64",
    "start": "node --expose-gc dist/index.js",
    "dev": "tsx --expose-gc src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "node -e \"try { require('node:child_process').execSync('npm run build', { stdio: 'ignore' }); } catch {}\""
  },
  "build": {
    "appId": "com.tabit.tbot.desktop",
    "productName": "T Bot",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "scripts/**/*",
      "assets/**/*",
      "build/icon.*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "scripts/**/*",
      "**/*.ps1",
      "**/*.dll"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "T-Bot-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "T Bot",
      "runAfterFinish": false,
      "installerIcon": "build/installerIcon.ico",
      "uninstallerIcon": "build/installerIcon.ico"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "playwright-core": "^1.64.1",
    "typescript": "^5.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "tsx": "^4.19.0"
  }
}
